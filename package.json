{
  "name": "terjemah-langsung",
  "version": "1.0.0",
  "author": "Tomas Sual",
  "private": true,
  "type": "module",
  "description": "Terjemah Langsung: terjemah secara langsung semasa anda menaip atau bercakap. PWA untuk iPhone dan iPad (juga Android dan komputer).",
  "scripts": {
    "start": "node tools/serve.mjs --build",
    "build": "node tools/build.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "e2e": "node --test --test-concurrency=1 \"tests/e2e/*.e2e.mjs\"",
    "icons": "node tools/gen-icons.mjs",
    "lint": "eslint src tools tests",
    "pretest": "npm run lint",
    "deploy:netlify": "node tools/deploy-netlify.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "globals": "^17.14.0",
    "jszip": "^3.10.2",
    "lucide-static": "^1.77.0",
    "playwright": "^1.64.1"
  }
}
